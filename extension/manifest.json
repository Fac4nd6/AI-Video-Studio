{
  "manifest_version": 3,
  "name": "AI Video Studio",
  "version": "0.1.10",
  "description": "Organiza prompts y prepara una cola segura para Google Flow.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Video Studio",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
